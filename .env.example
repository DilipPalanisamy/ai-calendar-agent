# =================================================================
# AI Calendar Agent - Environment Configuration
# =================================================================

# Google Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Google OAuth 2.0 Credentials (Get from https://console.cloud.google.com/)
# Configure Authorized redirect URI: http://localhost:8000/auth/callback (or your Render URL/auth/callback)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Session Secret Key for Starlette Cookie Encryption (generate random string)
SECRET_KEY=super_secret_random_key_change_in_production_12345

# Base URL for Render / Production Deployment (leave commented or set for local dev)
RENDER_EXTERNAL_URL=http://localhost:8000

# Default Timezone for Calendar parsing
CALENDAR_TIMEZONE=Asia/Kolkata

# Server Host & Port
HOST=0.0.0.0
PORT=8000
